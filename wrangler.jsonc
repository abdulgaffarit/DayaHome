/**
 * Wrangler configuration for dayarampur.com
 *
 * Secrets (SSLCOMMERZ credentials, SESSION_SECRET, TURNSTILE_SECRET, email
 * credentials) are NEVER stored here. Set them with:
 *   npx wrangler secret put SSLCOMMERZ_STORE_PASSWORD --env production
 * For local development put them in `.dev.vars` (git-ignored).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayarampur",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  // A custom entry rather than vinext's own `vinext/server/fetch-handler`,
  // which exports only `fetch`. Cloudflare delivers cron triggers to a
  // separate `scheduled` export, so the Worker needs an entry with both.
  // src/worker.ts delegates every HTTP request straight back to vinext.
  "main": "src/worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  },
  // Gives every environment a *.workers.dev address, so the app is reachable
  // before (and independently of) any custom domain.
  "workers_dev": true,

  // Time-based marketplace jobs: expiring listings, and starting and ending
  // advertisement campaigns. Hourly is well inside the tolerance for both —
  // a listing that expires up to an hour late harms nobody — and every job is
  // idempotent, so an extra firing is a no-op. See src/server/jobs/.
  //
  // Repeated in each environment below: `vinext build` flattens the config
  // and an env block that omits `triggers` would otherwise inherit nothing.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // ---- development (local `wrangler dev` / `vinext dev`) ----
  "vars": {
    "APP_ENV": "development",
    "NEXT_PUBLIC_SITE_URL": "http://localhost:3000",
    "SSLCOMMERZ_IS_SANDBOX": "true",
    "CONTACT_UNLOCK_PRICE_BDT": "50"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dayarampur-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROPERTY_IMAGES",
      "bucket_name": "dayarampur-property-images-dev"
    }
  ],

  "env": {
    "staging": {
      "name": "dayarampur-staging",
      "workers_dev": true,
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "vars": {
        "APP_ENV": "staging",
        "NEXT_PUBLIC_SITE_URL": "https://staging.dayarampur.com",
        "SSLCOMMERZ_IS_SANDBOX": "true",
        "CONTACT_UNLOCK_PRICE_BDT": "50"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dayarampur-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PROPERTY_IMAGES",
          "bucket_name": "dayarampur-property-images-staging"
        }
      ]
    },
    "production": {
      "name": "dayarampur",
      "workers_dev": true,
      "triggers": {
        "crons": ["0 * * * *"]
      },
      // Custom domains require dayarampur.com to already be a zone in this
      // Cloudflare account. Until it is, deploy with --env staging (or comment
      // these out) — the workers.dev address above works either way.
      "routes": [
        { "pattern": "dayarampur.com", "custom_domain": true },
        { "pattern": "www.dayarampur.com", "custom_domain": true }
      ],
      "vars": {
        "APP_ENV": "production",
        "NEXT_PUBLIC_SITE_URL": "https://dayarampur.com",
        "SSLCOMMERZ_IS_SANDBOX": "false",
        "CONTACT_UNLOCK_PRICE_BDT": "50"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dayarampur-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PROPERTY_IMAGES",
          "bucket_name": "dayarampur-property-images"
        }
      ]
    }
  }
}
