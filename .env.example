# ---------------------------------------------------------------------------
# dayarampur.com — environment variable reference
#
# NOTE: In production these are NOT read from a .env file. Cloudflare resource
# bindings (D1 / R2) live in wrangler.jsonc, and every secret below must be set
# with `wrangler secret put <NAME> --env <environment>`.
#
# For local development copy this file to `.dev.vars` (git-ignored) — that is
# the file Wrangler/vinext loads into `env` during `npm run dev`.
# ---------------------------------------------------------------------------

# --- Site ---
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sessions (secret) ---
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# --- SSLCOMMERZ (secrets) ---
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_SANDBOX=true

# Fixed server-side price of one contact unlock, in BDT.
# The browser NEVER supplies this value.
CONTACT_UNLOCK_PRICE_BDT=50

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Email provider abstraction ---
# EMAIL_PROVIDER: console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="dayarampur.com <no-reply@dayarampur.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Map provider abstraction ---
# MAP_PROVIDER: maplibre | google
MAP_PROVIDER=maplibre
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Public R2 asset base URL (custom domain in front of the R2 bucket) ---
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:3000/api/images
